{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:base",
  ],
  timezone: "Asia/Tokyo",

  "github-actions": {
    enabled: true,
    pinDigests: true,
    automerge: false,
    labels: ["renovate"],
    schedule: [
      "at 22:30 on Tuesday",
    ],
  },
}
