{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:base",
  ],

  "github-actions": {
    enabled: true,
    pinDigests: true,
    automerge: false,
    labels: ["renovate"],
    schedule: [
      "at 13:05 on Tuesday", // every Tuesday at 13:05 UTC = 22:05 JST
    ],
  },
}
